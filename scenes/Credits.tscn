bbcode_enabled = true
text = "Snail Mail was conceived, created, and programmed by Ben Massey\n[url=mailto:benjamin.w.massey@gmail.com]benjamin.w.massey@gmail.com[/url]\n\nMain Song\n[url]https://freemusicarchive.org/music/Beat_Doctor/Best_Bytes_Volume_1/16--Beat_Doctor--Too_Retro[/url]\n\nPuff Sound\n[url]https://freesound.org/people/Speedenza/sounds/167929/[/url]\n\nAww Sound\n[url]https://freesound.org/people/phmiller42/sounds/124996/[/url]\n\nBoing Sound\n[url]https://freesound.org/people/pan14/sounds/334032/[/url]\n\nCheer Sound\n[url]https://freesound.org/people/jayfrosting/sounds/333404/[/url]\n\nDing Sound\n[url]https://freesound.org/people/MashedTatoes2/sounds/515643/[/url]\n\nSnail 3D Model\n[url]https://free3d.com/3d-model/snail-v2--997207.html[/url]\n\nHouse 3D Model\n[url]https://www.cgtrader.com/free-3d-models/exterior/house/fantasy-house-36fc0216-613d-4104-abe1-952265cd6981[/url]\n\nEnvelope Image\n[url]https://wikiclipart.com/envelope-clipart_23418/[/url]\n\nHat 3D Model\n[url]https://www.cgtrader.com/free-3d-models/character/other/lego-cap[/url]\n\nSalt Shaker Image\n[url]https://www.clipartmax.com/middle/m2i8i8H7m2Z5H7i8_salt-shaker-salt-clip-art/[/url]\n\nGround Texture\n[url]https://cc0textures.com/view?id=Ground037[/url]\n\nStone 3D Model\n[url]https://www.cgtrader.com/free-3d-models/scanned/various/stone-3d-scan[/url]\n\nMailbox 3D Model\n[url]https://www.cgtrader.com/free-3d-models/exterior/house/mailbox-9d230736-f26a-4d2c-998d-b773fb6ec15d[/url]\n\nMushroom 3D Model\n[url]https://www.cgtrader.com/free-3d-models/plant/other/mushroom-bend[/url]\n\nRock Texture\n[url]https://cc0textures.com/view?id=Rock033[/url]\n\nText Font\n[url]https://fonts.google.com/specimen/Chewy[/url]\n\nRocket 3D Model\n[url]https://www.cgtrader.com/free-3d-models/aircraft/jet/rocket-3d-render[/url]"
